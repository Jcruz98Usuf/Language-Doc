# ---------------------------------------------------------------------------
# Language Doctor - local-first configuration
#
# Copy this file to `.env` and adjust if needed. No cloud AI provider and no
# API keys are used anywhere in this project.
# ---------------------------------------------------------------------------

# OLLAMA_BASE_URL: Local inference runtime. The browser never talks to it
# directly: React -> Express API -> this URL.
# ── Translation engine (Phase 1.5) ──────────────────────────────────────────
# Which provider serves POST /api/translate. "auto" prefers a dedicated local
# translation model when one is available and falls back to the chat model.
# TRANSLATION_PROVIDER=auto
#
# Option A (in-process, no extra service): opus-mt ONNX models via
# transformers.js. Weights download once, then inference is fully offline.
# TRANSLATION_MT_HF_MODELS="en-sw=Xenova/opus-mt-en-sw,sw-en=Xenova/opus-mt-sw-en"
# TRANSLATION_MT_HF_CACHE=benchmarks/translation/.hf-cache
#
# Option B (separate sidecar process, e.g. CTranslate2 / Argos / Marian):
# TRANSLATION_MT_URL=http://127.0.0.1:5000

# ── Intelligence engine (Ollama / Qwen) ─────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OLLAMA_MODEL: Local model for summaries and profile extraction.
OLLAMA_MODEL=qwen3:1.7b

# OLLAMA_TRANSLATION_MODEL: optional. Runs translation on a *different* local
# model than the intelligence engine. Unset = OLLAMA_MODEL is used for both.
# Benchmarking showed larger local models translate Swahili better but several
# times slower, so only set this after a model passes the translation gate
# (benchmarks/translation/README.md).
# OLLAMA_TRANSLATION_MODEL=

# OLLAMA_TIMEOUT_MS: Maximum time to wait for one local model response.
OLLAMA_TIMEOUT_MS=120000

# OLLAMA_HEALTH_TIMEOUT_MS: Maximum time for the /api/health probe.
OLLAMA_HEALTH_TIMEOUT_MS=5000

# PORT: Express + Vite server port.
PORT=3000

# Optional override for private-session join links (/join/<id>). When unset,
# the server auto-detects LAN IPv4 addresses and offers each as a QR candidate.
# Do not use localhost when pairing from a phone.
# HOST_URL=http://192.168.1.71:3000

# ── Local speech-to-text (Phase 7A, host laptop only) ───────────────────────
# Voice input on the HOST laptop runs locally: the browser records raw PCM and
# POSTs it to /api/transcribe, which runs Whisper on this machine. Nothing is
# written to disk and no audio is sent to any cloud service. The PHONE stays
# type-only by design.
#
# STT_PROVIDER: auto (in-process ONNX engine) | whisper-onnx | whisper-cpp
# STT_PROVIDER=auto
#
# STT_WHISPER_MODEL_EN: English checkpoint. base.en is the default because the
# benchmark showed tiny.en mishearing a year (2026 -> 2021) and splitting a drug
# name; base.en was correct on both, at 1.76x the latency (3.0s vs 1.7s warm).
# Use tiny.en when latency matters more than number/drug fidelity.
# STT_WHISPER_MODEL_EN=base.en
#
# STT_WHISPER_MODEL_MULTI: multilingual checkpoint for the non-English panel
# (French/Swahili). NOT measured on this machine: it has no French or Swahili
# voice, so treat it as unvalidated until someone records real audio.
# STT_WHISPER_MODEL_MULTI=tiny
#
# STT_WHISPER_CACHE: where the ONNX weights are cached after the one-time
# download (shared with the translation models).
# STT_WHISPER_CACHE=benchmarks/translation/.hf-cache
#
# STT_WHISPER_TIMEOUT_MS: bound on a single transcription call (model loading is
# not bounded, so a first-time download is never aborted).
# STT_WHISPER_TIMEOUT_MS=120000
#
# Optional whisper.cpp sidecar (not installed here). whisper.cpp is MIT, but the
# in-process engine needs no extra binary, so the sidecar is off unless selected:
# STT_PROVIDER=whisper-cpp
# STT_SIDECAR_URL=http://127.0.0.1:8081
# STT_SIDECAR_MODEL=ggml-base.en.bin

# ── Temporary private sessions (Phase 3, memory only) ───────────────────────
# SESSION_TTL_MINUTES: sliding idle lifetime. Refreshed by activity, so 30
# minutes covers a translation session without holding data in memory all day.
# Sessions live in RAM only: no database, nothing written to disk, and
# conversation content is never logged.
SESSION_TTL_MINUTES=30

# SESSION_ABSOLUTE_TTL_MINUTES: hard cap on total lifetime, even with activity.
# Defaults to 4x SESSION_TTL_MINUTES when unset.
# SESSION_ABSOLUTE_TTL_MINUTES=120

